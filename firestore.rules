rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /todos/{todoId} {
      // Permite leitura pública das tarefas
      allow read: if true;
      
      // Permite criação se o texto for válido e não vazio
      allow create: if request.resource.data.text is string 
                    && request.resource.data.text.size() > 0 
                    && request.resource.data.completed is bool;

      // Permite atualização de status, texto ou campos
      allow update: if request.resource.data.text is string 
                    && request.resource.data.completed is bool;

      // Permite remoção
      allow delete: if true;
    }
  }
}
